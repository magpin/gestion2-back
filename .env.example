DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=db_gestion5

PORT=3001
NODE_ENV=development
API_PREFIX=api/v1

# Firma de los tokens que emite el módulo `nucleo`.
# En producción: 32 caracteres o más, y distinto del de desarrollo.
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRES_IN=8h

# Clave AES-256-GCM de las columnas _enc (certificados y PIN de la DIAN).
# 32 bytes en base64. Generar otra en produccion:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLAVE_CIFRADO=generar-con-el-comando-de-abajo

# Cabecera x-clave-provision que autoriza el alta de cuentas nuevas.
CLAVE_PROVISION=cambiar-esta-clave-de-aprovisionamiento

# Conexion de la API. Debe ser gestion_app: sujeta a RLS y sin privilegio DELETE.
# Si se deja vacia, la API cae a DB_USERNAME y avisa al arrancar que el
# aislamiento entre empresas NO esta activo.
DB_APP_USERNAME=
DB_APP_PASSWORD=

# Conexion de aprovisionamiento (gestion_provision, con BYPASSRLS). Solo la usa
# el alta de tenants. Sin ella, POST /tenants responde 503.
DB_PROVISION_USERNAME=
DB_PROVISION_PASSWORD=
