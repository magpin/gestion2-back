# Lo que `docker compose` necesita. Es distinto de `.env.example`, que es el de
# la API corriendo sin contenedores:
#
#   cp .env.compose.example .env
#
# `.env` no se versiona. Este sí, para que se sepa qué hay que llenar.

# ── Base de datos ────────────────────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=db_gestion
DB_PORT=5432

# ── API ──────────────────────────────────────────────────────────────────────
# 32 caracteres o más, y distinto del de producción.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Clave AES-256-GCM de las columnas cifradas (certificados y PIN de la DIAN).
# 32 bytes en base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLAVE_CIFRADO=

# ── MinIO: dónde viven las imágenes ──────────────────────────────────────────
# El usuario raíz de MinIO. En producción se crea una llave de acceso propia
# para la aplicación y esta no se usa nunca más.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=gestion
S3_REGION=us-east-1

# La dirección que el NAVEGADOR puede alcanzar. Adentro de compose el backend
# le habla a `http://minio:9000`; la URL firmada que recibe el navegador tiene
# que apuntar acá. En producción es el dominio público del bucket.
S3_ENDPOINT_PUBLICO=http://localhost:9000

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
